/* ================= TODAY ================= */
function vToday(){
  const t=today(),tk=dk(t);
  const s=dayStats(tk);
  const hs=habitsOn(tk);
  let chain="";
  for(let i=27;i>=0;i--){
    const d=addD(t,-i),k=dk(d),ds=dayStats(k);
    const cls=ds.total===0?"chip off":(ds.done===ds.total?"chip full":(ds.done>0?"chip part":"chip"));
    chain+=`<div class="${cls}" title="${k} — ${ds.done}/${ds.total}"></div>`;
  }
  const pending=hs.filter(h=>!isDone(h.id,tk));
  const next=pending[0];
  const refl=state.reflections[tk]||"";

  return `
  <div class="stack">
    <section class="card hero">
      <div class="hero-top">
        <div class="hero-date">${fmtDate(t)}</div>
        <div class="hero-big" style="align-items:center">
          <em>${s.pct}%</em>
        </div>
      </div>
      <div class="hero-big">
        <b>${s.done}</b><span>/ ${s.total}</span>
      </div>
      <div class="hero-note">
        ${s.total===0
          ? "Nothing scheduled today."
          : s.done===s.total
            ? "Every habit done today. The chain holds."
            : `${s.total-s.done} habit${s.total-s.done===1?"":"s"} remaining.`}
      </div>
      <div class="chain">${chain}</div>
      <div class="chain-cap"><span>28 days ago</span><span>Today</span></div>
    </section>

    ${hs.length===0?"":next?`
      <div class="nextup">
        <div style="flex:1">
          <div class="lbl">Next up</div>
          <div class="nm">${esc(next.name)}</div>
          <div class="mt">${next.time} · ${next.duration} min</div>
        </div>
        <button class="btn primary sm" data-act="timer" data-id="${next.id}">Start</button>
      </div>`:`
      <div class="nextup">
        <div style="flex:1">
          <div class="lbl">All clear</div>
          <div class="nm">Every habit done today.</div>
        </div>
      </div>`}

    ${hs.length===0?
      `<div class="card empty">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg></div>
        No habits scheduled today.<br>
        <button class="btn primary sm" style="margin-top:14px" data-act="tab" data-tab="discover">Browse the library</button>
      </div>`
      : hs.map(h=>habitCard(h,tk)).join("")}

