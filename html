/* ============================================================
   POST-RENDER
   ============================================================ */
function post(){
  const r=document.getElementById("refl");
  if(r)r.addEventListener("input",()=>{state.reflections[dk(today())]=r.value;save()});

  const q=document.getElementById("lib-q");
  if(q){
    q.addEventListener("input",()=>{
      libQuery=q.value;
      clearTimeout(post._t);
      post._t=setTimeout(()=>{
        const pos=q.selectionStart;
        render();
        const nq=document.getElementById("lib-q");
        if(nq){nq.focus();try{nq.setSelectionRange(pos,pos)}catch(e){}}
      },140);
    });
  }

  const file=document.getElementById("importfile");
  if(file)file.addEventListener("change",e=>{
    const f=e.target.files&&e.target.files[0];
    if(!f)return;
    const reader=new FileReader();
    reader.onload=()=>{
      try{
        const d=JSON.parse(reader.result);
        if(!d||!Array.isArray(d.habits))throw new Error("bad file");
        state={habits:d.habits,log:d.log||{},reflections:d.reflections||{},settings:Object.assign({notifications:false,ai:"deepseek"},d.settings||{}),reminded:{},timer:null};
        save();render();toast("Backup imported");
      }catch(err){toast("That file could not be read")}
    };
    reader.readAsText(f);
    e.target.value="";
  });
}

/* ============================================================
   EVENTS
   ============================================================ */
document.addEventListener("click",e=>{
  const el=e.target.closest("[data-act]");
  if(!el)return;
  const act=el.dataset.act;

  switch(act){
    case "tab":
      if(el.dataset.tab==="discover"){libQuery="";libCat="All"}
      go({name:el.dataset.tab});
      break;

    case "libCat":
      libCat=el.dataset.cat;
      render();
      break;

    case "libOpen":
      go({name:"lib",id:el.dataset.id});
      break;

    case "libAdd":
      libAdd(el.dataset.id);
      break;

    case "toggle":{
      const id=el.dataset.id,k=dk(today());
      const now=!isDone(id,k);
      mark(id,k,now);
      if(now){const h=state.habits.find(x=>x.id===id);toast(`${h?h.name:"Habit"} done ✓`)}
      render();
      break;
    }

    case "habit":
      go({name:"habit",id:el.dataset.id});
      break;

    case "timer":
      openTimer(el.dataset.id);
      break;

    case "del":{
      const id=el.dataset.id,h=state.habits.find(x=>x.id===id);
      if(!h)break;
      if(!confirm(`Delete "${h.name}"?`))break;
      state.habits=state.habits.filter(x=>x.id!==id);
      if(state.timer&&state.timer.habitId===id)state.timer=null;
      save();toast("Habit deleted");render();
      break;
    }

    case "addHabit": addHabit(); break;

    case "coach":{
      const h=state.habits.find(x=>x.id===el.dataset.id);
      const box=document.getElementById("coach-in");
      const txt=box?box.value.trim():"";
      if(!h)break;
      if(!txt){toast("Describe what you do first");break}
      const prompt=`I'm working on this daily habit: "${h.name}" (${h.duration} minutes, scheduled at ${h.time}).\n\nWhat I do: ${txt}\n\nPlease act as my habit coach. Give me specific, practical advice: what to change, how to handle the obstacle I described, and one small thing to try tomorrow.`;
      openAI(prompt,el.dataset.ai||state.settings.ai);
      break;
    }

    case "quiz":{
      const h=state.habits.find(x=>x.id===el.dataset.id);
      const topicEl=document.getElementById("quiz-t");
      const diffEl=document.getElementById("quiz-d");
      const topic=topicEl?topicEl.value.trim():"";
      const diff=diffEl?diffEl.value:"Medium";
      if(!topic){toast("Enter a topic first");break}
      const prompt=`Quiz me on: ${topic}\nDifficulty: ${diff}\nContext: I'm building a daily habit called "${h?h.name:"this"}".\n\nAsk me 5 questions, one at a time. Wait for my answer before asking the next. After each answer, tell me whether I was right with a brief explanation, then move on. At the end, give me a score out of 5 and one thing to review.`;
      openAI(prompt,el.dataset.ai||state.settings.ai);
      break;
    }

    case "tstart":startT();break;
    case "tpause":pauseT();break;
    case "treset":resetT();break;
    case "tdone":doneT();break;

    case "notif":{
      if(!("Notification" in window)){toast("Not supported");break}
      if(state.settings.notifications){state.settings.notifications=false;save();render();toast("Notifications off")}
      else{
        Notification.requestPermission().then(p=>{
          state.settings.notifications=(p==="granted");
          save();render();
          toast(p==="granted"?"Notifications on":"Permission denied");
        });
      }
      break;
    }

    case "setai":
      state.settings.ai=el.dataset.v;save();render();toast("AI set to "+el.dataset.v);
      break;

    case "install":
      installApp();
      break;

    case "export":{
      const blob=new Blob([JSON.stringify(state,null,2)],{type:"application/json"});
      const url=URL.createObjectURL(blob);
      const a=document.createElement("a");
      a.href=url;a.download=`discipline-${dk(today())}.json`;
      document.body.appendChild(a);a.click();a.remove();
      setTimeout(()=>URL.revokeObjectURL(url),2000);
      toast("Backup downloaded");
      break;
    }

    case "import":{
      const f=document.getElementById("importfile");
      if(f)f.click();
      break;
    }

    case "wipe":{
      if(!confirm("Erase all habits, history and reflections? This cannot be undone."))return;
      localStorage.removeItem(KEY);
      state={habits:[],log:{},reflections:{},settings:{notifications:false,ai:"deepseek"},reminded:{},timer:null};
      save();go({name:"today"});toast("All data cleared");
      break;
    }
  }
});

/* ============================================================
   AI REDIRECT
   ============================================================ */
function openAI(prompt,which){
  which=which||state.settings.ai||"deepseek";
  const urls={deepseek:"https://chat.deepseek.com/",populi:"https://populi.ai/"};
  const url=urls[which]||urls.deepseek;
  const open=()=>window.open(url,"_blank","noopener");
  if(navigator.clipboard&&navigator.clipboard.writeText){
    navigator.clipboard.writeText(prompt).then(()=>{
      toast("Prompt copied — paste it in the chat");
      open();
    }).catch(()=>{open();toast("Opening the assistant…")});
  }else{
    // fallback: textarea select
    const ta=document.createElement("textarea");
    ta.value=prompt;document.body.appendChild(ta);ta.select();
    try{document.execCommand("copy")}catch(e){}
    ta.remove();
    toast("Prompt copied — paste it in the chat");
    open();
  }
}

/* ============================================================
   TOAST
   ============================================================ */
let toastT=null;
function toast(msg){
  const el=document.getElementById("toast");
  el.innerHTML=`<div class="tt">${esc(msg)}</div>`;
  el.classList.add("show");
  clearTimeout(toastT);
  toastT=setTimeout(()=>el.classList.remove("show"),2800);
}

/* ============================================================
   BEEP / NOTIFY
   ============================================================ */
function beep(){
  try{
    const Ctx=window.AudioContext||window.webkitAudioContext;
    if(!Ctx)return;
    const ctx=new Ctx();
    const o=ctx.createOscillator(),g=ctx.createGain();
    o.type="sine";o.frequency.value=880;
    o.connect(g);g.connect(ctx.destination);
    g.gain.setValueAtTime(0.0001,ctx.currentTime);
    g.gain.exponentialRampToValueAtTime(0.2,ctx.currentTime+0.02);
    g.gain.exponentialRampToValueAtTime(0.0001,ctx.currentTime+0.55);
    o.start();o.stop(ctx.currentTime+0.6);
    setTimeout(()=>ctx.close().catch(()=>{}),900);
  }catch(e){}
}
function sysNotify(title,body){
  try{
    if(state.settings.notifications&&"Notification" in window&&Notification.permission==="granted"){
      new Notification(title,{body});
    }
  }catch(e){}
}

/* ============================================================
   REMINDERS
   ============================================================ */
function checkReminders(){
  const now=new Date(),tk=dk(now);
  const hhmm=`${pad(now.getHours())}:${pad(now.getMinutes())}`;
  state.reminded[tk]=state.reminded[tk]||{};
  let changed=false;
  state.habits.forEach(h=>{
    if(!schedOn(h,now))return;
    if(h.time!==hhmm)return;
    if(isDone(h.id,tk))return;
    if(state.reminded[tk][h.id])return;
    state.reminded[tk][h.id]=true;changed=true;
    toast(`⏰ ${h.name} — ${h.duration} min`);
    beep();
    if(navigator.vibrate){try{navigator.vibrate([140,70,140])}catch(e){}}
    sysNotify(`Time for ${h.name}`,`${h.duration} minutes.`);
  });
  const keys=Object.keys(state.reminded);
  if(keys.length>5){keys.sort();while(keys.length>3)delete state.reminded[keys.shift()];changed=true}
  if(changed)save();
}

/* ============================================================
   PWA INSTALL
   ============================================================ */
let deferredPrompt=null;
window.addEventListener("beforeinstallprompt",e=>{
  e.preventDefault();deferredPrompt=e;
  const b=document.getElementById("installBtn");
  if(b){b.disabled=false;b.textContent="Install on this device"}
});
window.addEventListener("appinstalled",()=>{deferredPrompt=null;toast("App installed")});
function installApp(){
  if(deferredPrompt){
    deferredPrompt.prompt();
    deferredPrompt.userChoice.then(c=>{
      if(c.outcome==="accepted")toast("Installing…");
      deferredPrompt=null;
    });
  }else{
    toast("Use your browser menu → Install app / Add to home screen");
  }
}

