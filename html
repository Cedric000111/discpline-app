/* ================= TIMER ================= */
function vTimer(){
  const t=state.timer;
  if(!t)return `<div class="card empty">No timer running.<br><button class="btn primary sm" style="margin-top:14px" data-act="tab" data-tab="today">Back to Today</button></div>`;
  const h=state.habits.find(x=>x.id===t.habitId);
  if(!h){state.timer=null;save();return `<div class="card empty">Habit no longer exists.</div>`}
  const rem=t.running?Math.max(0,t.endsAt-Date.now()):t.remaining;
  const total=t.total||h.duration*60000;
  const R=104,C=2*Math.PI*R;
  const prog=Math.min(1,Math.max(0,1-rem/total));
  return `
  <div class="stack">
    <button class="crumb" data-act="habit" data-id="${h.id}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m15 18-6-6 6-6"/></svg>
      ${esc(h.name)}
    </button>
    <section class="card">
      <div class="ringwrap">
        <div class="ring">
          <svg width="236" height="236">
            <circle cx="118" cy="118" r="${R}" fill="none" stroke="#232932" stroke-width="10"/>
            <circle id="tring" cx="118" cy="118" r="${R}" fill="none" stroke="#c9a961" stroke-width="10"
              stroke-linecap="round" stroke-dasharray="${C.toFixed(1)}" stroke-dashoffset="${(C*(1-prog)).toFixed(1)}"/>
          </svg>
          <div class="inr">
            <div>
              <b id="tcount">${fmtMS(rem)}</b>
              <span>${esc(h.name)}</span>
            </div>
          </div>
        </div>
        <div style="display:flex;gap:8px;flex-wrap:wrap;justify-content:center;margin-top:26px">
          ${t.running
            ? `<button class="btn primary" data-act="tpause">Pause</button>`
            : `<button class="btn primary" data-act="tstart">${rem<total?"Resume":"Start"}</button>`}
          <button class="btn" data-act="treset">Reset</button>
          <button class="btn" data-act="tdone">Mark done</button>
        </div>
        <p class="hint" style="margin-top:20px;text-align:center;max-width:340px">
          Keeps counting if you leave this page. The habit is marked done automatically when it reaches zero.
        </p>
      </div>
    </section>
  </div>`;
}
function fmtMS(ms){const s=Math.max(0,Math.ceil(ms/1000));return `${Math.floor(s/60)}:${pad(s%60)}`}
function updateTimerUI(){
  const t=state.timer;
  if(!t||route.name!=="timer")return;
  const c=document.getElementById("tcount"),r=document.getElementById("tring");
  if(!c||!r)return;
  const rem=t.running?Math.max(0,t.endsAt-Date.now()):t.remaining;
  const total=t.total||1;
  c.textContent=fmtMS(rem);
  const C=2*Math.PI*104;
  r.setAttribute("stroke-dashoffset",(C*Math.min(1,Math.max(0,1-rem/total))).toFixed(1));
}
function openTimer(id){
  const h=state.habits.find(x=>x.id===id);
  if(!h)return;
  const total=h.duration*60000;
  state.timer={habitId:id,total,remaining:total,endsAt:null,running:false};
  save();go({name:"timer"});
}
function startT(){const t=state.timer;if(!t)return;if(t.remaining<=0)t.remaining=t.total;t.endsAt=Date.now()+t.remaining;t.running=true;save();render()}
function pauseT(){const t=state.timer;if(!t||!t.running)return;t.remaining=Math.max(0,t.endsAt-Date.now());t.running=false;save();render()}
function resetT(){const t=state.timer;if(!t)return;t.remaining=t.total;t.running=false;t.endsAt=null;save();render()}
function doneT(){
  const t=state.timer;if(!t)return;
  mark(t.habitId,dk(today()),true);
  const h=state.habits.find(x=>x.id===t.habitId);
  state.timer=null;save();
  if(route.name==="timer")go({name:"today"});else render();
  if(h)toast(`${h.name} done ✓`);
  beep();
}

/* ================= PROGRESS ================= */
function vProgress(){
  const t=today();
  let chart="";
  for(let i=6;i>=0;i--){
    const d=addD(t,-i),k=dk(d),s=dayStats(k);
    const cls=s.pct>=80?"g":s.pct>=40?"m":s.pct>0?"l":"";
    chart+=`<div class="bcol"><div class="bar2 ${cls}" style="height:${Math.max(3,s.pct)}%" title="${k}: ${s.done}/${s.total}"></div><div class="blab">${DL[d.getDay()]}</div></div>`;
  }
  function week(off){
    let dn=0,tt=0;
    for(let i=0;i<7;i++){
      const k=dk(addD(t,-(off*7+i)));
      const s=dayStats(k);dn+=s.done;tt+=s.total;
    }
    return{pct:tt?Math.round(dn/tt*100):0};
  }
  const tw=week(0),lw=week(1),delta=tw.pct-lw.pct;

  const rates=state.habits.map(h=>({h,...rate(h,7)})).filter(x=>x.sched>0);
  const strong=rates.length?rates.reduce((a,b)=>b.pct>a.pct?b:a):null;
  const weak=rates.length?rates.reduce((a,b)=>b.pct<a.pct?b:a):null;

  let dayList="";
  for(let i=13;i>=0;i--){
    const d=addD(t,-i),k=dk(d),s=dayStats(k);
    dayList+=`<div class="drow"><div class="dn">${DSHORT[d.getDay()]} ${d.getDate()}</div><div class="db"><i style="width:${s.pct}%"></i></div><div class="dv">${s.done}/${s.total}</div></div>`;
  }
  const perHabit=state.habits.map(h=>{
    const r=rate(h,30);
    return `<div style="margin-bottom:16px">
      <div style="display:flex;justify-content:space-between;gap:10px;font-size:13.5px"><span style="font-weight:600">${esc(h.name)}</span><span class="hint">${r.pct}% · ${r.done}/${r.sched}</span></div>
      <div class="hbar"><i style="width:${r.pct}%"></i></div>
      <div class="hint" style="margin-top:6px">${curStreak(h)} current · ${bestStreak(h)} best</div>
    </div>`;
  }).join("");

  const maxBest=state.habits.length?Math.max(...state.habits.map(bestStreak)):0;
  const badges=[7,21,66].map(n=>`<div class="badge ${maxBest>=n?"on":""}"><b>${n}</b><span>days</span></div>`).join("");

  return `
  <div class="stack">
    <div>
      <h1 style="margin:0 0 4px">Progress</h1>
      <div class="hint">A quiet record of what you have actually done.</div>
    </div>

    <section class="card">
      <div class="hd"><h3>Last 7 days</h3></div>
      <div class="chart">${chart}</div>
    </section>

    <section class="card">
      <div class="hd"><h3>Weekly review</h3></div>
      <div class="statgrid">
        <div class="stat"><b>${tw.pct}%</b><span>This week</span></div>
        <div class="stat"><b>${lw.pct}%</b><span>Last week</span></div>
        <div class="stat"><b style="color:${delta>0?"var(--good)":delta<0?"var(--danger)":"var(--text)"}">${delta>0?"+":""}${delta}%</b><span>Change</span></div>
      </div>
      ${strong?`<hr class="rule"><div style="font-size:13.5px;color:var(--text-2)">
        <div>Strongest — <b>${esc(strong.h.name)}</b> · ${strong.pct}%</div>
        <div style="margin-top:6px">Needs work — <b>${esc(weak.h.name)}</b> · ${weak.pct}%</div>
      </div>`:`<p class="hint" style="margin-top:14px">Nothing scheduled in the last 7 days.</p>`}
    </section>

    <section class="card">
      <div class="hd"><h3>Day by day</h3><span class="hint">14 days</span></div>
      <div class="daylist">${dayList}</div>
    </section>

    <section class="card">
      <div class="hd"><h3>Per habit</h3><span class="hint">30 days</span></div>
      ${state.habits.length?perHabit:`<p class="hint">No habits yet.</p>`}
    </section>

    <section class="card">
      <div class="hd"><h3>Badges</h3></div>
      <div class="badges">${badges}</div>
      <p class="hint" style="margin-top:14px">Longest streak so far: <b style="color:var(--text)">${maxBest}</b> day${maxBest===1?"":"s"}.</p>
    </section>
  </div>`;
}

