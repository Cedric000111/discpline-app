      <div class="hd"><h3>Reflection</h3><span class="hint">Autosaved</span></div>
      <textarea class="ta" id="refl" placeholder="What went well? What got in the way?">${esc(refl)}</textarea>
    </section>
  </div>`;
}
function habitCard(h,tk){
  const done=isDone(h.id,tk);
  const st=curStreak(h);
  const t=today();
  let strip="";
  for(let i=6;i>=0;i--){
    const d=addD(t,-i),k=dk(d);
    const sch=schedOn(h,d),dn=isDone(h.id,k);
    strip+=`<span class="sd ${!sch?"off":dn?"on":"miss"}" title="${k}">${DL[d.getDay()]}</span>`;
  }
  return `
  <article class="habit ${done?"done":""}" data-act="habit" data-id="${h.id}">
    <div class="row">
      <button class="check ${done?"on":""}" data-act="toggle" data-id="${h.id}" aria-label="Toggle done">✓</button>
      <div style="flex:1;min-width:0">
        <div class="nm">${esc(h.name)}</div>
        <div class="meta">${h.time} · ${h.duration} min${st>0?` · <b>${st} day${st===1?"":"s"}</b> streak`:""}</div>
        <div class="strip">${strip}</div>
        <div class="quote">"${esc(quoteFor(h,tk))}"</div>
      </div>
      <button class="btn ghost sm" data-act="timer" data-id="${h.id}" aria-label="Start timer">▶</button>
    </div>
  </article>`;
}

