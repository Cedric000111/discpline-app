<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#0f1215">
<meta name="description" content="A disciplined daily habit tracker with a curated library of 55+ practices, quotes and book summaries.">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Discipline">
<title>Discipline — Daily Habits</title>
<link rel="manifest" href="manifest.json">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 512 512'%3E%3Crect width='512' height='512' rx='108' fill='%230f1215'/%3E%3Ccircle cx='256' cy='256' r='146' fill='none' stroke='%23c9a961' stroke-width='30'/%3E%3Cpath d='M180 258l56 56 100-118' fill='none' stroke='%23c9a961' stroke-width='34' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E">
<style>
/* =========================================================
   Discipline Tracker — professional editorial theme
   ========================================================= */
*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;-webkit-tap-highlight-color:transparent}

:root{
  --bg:#0f1215;
  --bg-2:#12161b;
  --surface:#161a1f;
  --surface-2:#1c2127;
  --surface-3:#232932;
  --line:#232932;
  --line-2:#2f3742;
  --text:#e9ecef;
  --text-2:#a4acb6;
  --text-3:#6d7580;
  --accent:#c9a961;
  --accent-2:#b8944a;
  --accent-soft:rgba(201,169,97,.10);
  --accent-line:rgba(201,169,97,.35);
  --good:#7da88c;
  --good-soft:rgba(125,168,140,.14);
  --danger:#c47b74;
  --danger-soft:rgba(196,123,116,.12);
  --r:12px;
  --r-sm:8px;
  --r-lg:18px;
  --sans:-apple-system,BlinkMacSystemFont,"Segoe UI",Inter,Roboto,Helvetica,Arial,sans-serif;
  --serif:"Iowan Old Style","Palatino Linotype",Palatino,Georgia,"Times New Roman",serif;
  --mono:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
}

body{
  background:var(--bg);
  color:var(--text);
  font:15px/1.55 var(--sans);
  font-feature-settings:"ss01","cv11";
  min-height:100vh;
  padding-bottom:96px;
}
@media(min-width:721px){ body{padding-bottom:48px} }

h1,h2,h3,h4{font-family:var(--serif);font-weight:600;letter-spacing:-.01em;margin:0 0 8px;color:var(--text);line-height:1.2}
h1{font-size:26px}
h2{font-size:20px}
h3{font-size:17px}
h4{font-size:15px}
p{margin:0 0 10px}
button{font-family:inherit;cursor:pointer}
a{color:var(--accent);text-decoration:none}
a:hover{text-decoration:underline}

/* ---------- header ---------- */
.top{
  position:sticky;top:0;z-index:40;
  background:rgba(15,18,21,.92);
  backdrop-filter:saturate(180%) blur(14px);
  -webkit-backdrop-filter:saturate(180%) blur(14px);
  border-bottom:1px solid var(--line);
}
.top-in{
  max-width:880px;margin:0 auto;padding:14px 20px;
  display:flex;align-items:center;gap:14px;
}
.brand{
  font-family:var(--serif);font-size:18px;font-weight:600;letter-spacing:.01em;
  display:flex;align-items:center;gap:10px;
}
.brand .mark{
  width:26px;height:26px;border-radius:8px;
  border:1.5px solid var(--accent);
  display:grid;place-items:center;
  color:var(--accent);font-size:13px;font-weight:700;
}
.brand .name em{font-style:italic;color:var(--accent);font-weight:600}
.lvl{margin-left:auto;text-align:right;font-size:11px;color:var(--text-3);letter-spacing:.04em;text-transform:uppercase}
.lvl b{display:block;font-size:12.5px;color:var(--text-2);letter-spacing:0;text-transform:none;font-weight:600;margin-bottom:4px}
.bar{width:96px;height:3px;border-radius:2px;background:var(--surface-3);overflow:hidden;margin-left:auto}
.bar>i{display:block;height:100%;background:var(--accent);transition:width .4s ease}
.gear{
  background:transparent;border:1px solid var(--line);width:34px;height:34px;
  border-radius:9px;color:var(--text-2);display:grid;place-items:center;
  transition:.15s;
}
.gear:hover{color:var(--text);border-color:var(--line-2)}
.gear svg{width:17px;height:17px}

/* ---------- top tabs (desktop) ---------- */
.tabs{
  max-width:880px;margin:0 auto;padding:0 14px 10px;
  display:flex;gap:2px;
}
.tab{
  flex:1;padding:9px 4px;border-radius:9px;background:transparent;border:none;
  color:var(--text-3);font-size:13px;font-weight:500;letter-spacing:.01em;
  transition:.15s;position:relative;
}
.tab:hover{color:var(--text-2)}
.tab.on{color:var(--text);background:var(--surface)}
.tab.on::after{
  content:"";position:absolute;left:50%;bottom:-10px;transform:translateX(-50%);
  width:24px;height:1.5px;background:var(--accent);border-radius:2px;
}

/* ---------- bottom nav (mobile) ---------- */
.bottomnav{
  display:none;position:fixed;left:0;right:0;bottom:0;z-index:50;
  background:rgba(15,18,21,.94);
  backdrop-filter:saturate(180%) blur(14px);
  -webkit-backdrop-filter:saturate(180%) blur(14px);
  border-top:1px solid var(--line);
  padding:6px 4px calc(6px + env(safe-area-inset-bottom));
}
.bottomnav-in{display:flex;max-width:520px;margin:0 auto}
.bn{
  flex:1;background:transparent;border:none;padding:8px 4px 6px;
  color:var(--text-3);font-size:10.5px;letter-spacing:.02em;
  display:flex;flex-direction:column;align-items:center;gap:3px;
  transition:.15s;
}
.bn svg{width:20px;height:20px;stroke:currentColor;fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
.bn.on{color:var(--accent)}
@media(max-width:720px){
  .tabs{display:none}
  .bottomnav{display:block}
  .top-in{padding:12px 16px}
}

/* ---------- shell ---------- */
.wrap{max-width:880px;margin:0 auto;padding:20px}
@media(max-width:720px){ .wrap{padding:16px} }
.stack>*+*{margin-top:12px}

/* ---------- cards ---------- */
.card{
  background:var(--surface);
  border:1px solid var(--line);
  border-radius:var(--r);
  padding:18px;
}
.card.tight{padding:14px}
.card.pad-lg{padding:22px}
.card.flat{background:transparent}
.card .hd{
  display:flex;align-items:center;justify-content:space-between;gap:12px;
  margin-bottom:12px;
}
.card .hd h3{margin:0}
.hint{color:var(--text-3);font-size:12.5px;line-height:1.55}
.lead{color:var(--text-2);font-size:14px}

/* ---------- rules / dividers ---------- */
.rule{height:1px;background:var(--line);margin:14px 0;border:none}

/* ---------- buttons ---------- */
.btn{
  font:inherit;font-size:13.5px;font-weight:500;letter-spacing:.01em;
  padding:9px 14px;border-radius:9px;
  background:var(--surface-2);color:var(--text);
  border:1px solid var(--line-2);
  transition:.15s;
  display:inline-flex;align-items:center;justify-content:center;gap:7px;
  white-space:nowrap;
}
.btn:hover{background:var(--surface-3);border-color:var(--line-2)}
.btn:active{transform:translateY(1px)}
.btn.primary{background:var(--accent);border-color:var(--accent);color:#1a1408;font-weight:600}
.btn.primary:hover{background:var(--accent-2);border-color:var(--accent-2)}
.btn.ghost{background:transparent;border-color:var(--line)}
.btn.ghost:hover{background:var(--surface-2)}
.btn.danger{background:transparent;border-color:var(--danger-soft);color:var(--danger)}
.btn.danger:hover{background:var(--danger-soft)}
.btn.sm{padding:6px 11px;font-size:12.5px;border-radius:7px}
.btn.block{width:100%}
.btn[disabled]{opacity:.5;cursor:not-allowed}

/* ---------- inputs ---------- */
.in,.ta,select.in{
  width:100%;font:inherit;font-size:14px;color:var(--text);
  background:var(--bg-2);border:1px solid var(--line-2);
  border-radius:9px;padding:10px 12px;
  outline:none;transition:.15s;
}
.in:focus,.ta:focus{border-color:var(--accent);background:var(--surface-2)}
.ta{resize:vertical;min-height:82px;line-height:1.55;font-family:inherit}
label.fl{display:block;font-size:11px;color:var(--text-3);margin-bottom:6px;letter-spacing:.06em;text-transform:uppercase;font-weight:500}
.field{margin-bottom:12px}
.field:last-child{margin-bottom:0}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
@media(max-width:480px){ .grid2{grid-template-columns:1fr} }

/* ---------- today ---------- */
.hero{
  padding:22px 22px 20px;
  background:linear-gradient(180deg,var(--surface),var(--bg-2));
}
.hero-top{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:16px}
.hero-date{color:var(--text-3);font-size:12px;letter-spacing:.08em;text-transform:uppercase}
.hero-big{display:flex;align-items:baseline;gap:10px}
.hero-big b{font-family:var(--serif);font-size:46px;font-weight:500;letter-spacing:-.03em;line-height:1}
.hero-big span{font-family:var(--serif);font-size:22px;color:var(--text-3)}
.hero-big em{font-style:normal;color:var(--accent);font-size:13px;font-weight:600;letter-spacing:.02em;margin-left:auto;align-self:center}
.hero-note{color:var(--text-2);font-size:13.5px;margin-top:8px}

.chain{display:grid;grid-template-columns:repeat(28,1fr);gap:3px;margin-top:18px}
.chip{aspect-ratio:1;border-radius:3px;background:var(--surface-3)}
.chip.full{background:var(--accent)}
.chip.part{background:rgba(201,169,97,.36)}
.chip.off{background:var(--bg-2);border:1px solid var(--line)}
.chain-cap{display:flex;justify-content:space-between;margin-top:7px;font-size:10.5px;color:var(--text-3);letter-spacing:.05em;text-transform:uppercase}

/* ---------- next up ---------- */
.nextup{
  display:flex;align-items:center;gap:14px;
  padding:14px 18px;border-radius:var(--r);
  background:var(--surface);border:1px solid var(--line);
  border-left:2px solid var(--accent);
}
.nextup .lbl{font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--accent);font-weight:600}
.nextup .nm{font-family:var(--serif);font-size:16px;font-weight:600;margin-top:3px}
.nextup .mt{font-size:12px;color:var(--text-3);margin-top:2px}

/* ---------- habit card ---------- */
.habit{
  padding:16px 18px;border-radius:var(--r);
  background:var(--surface);border:1px solid var(--line);
  transition:.15s;
  cursor:pointer;
}
.habit:hover{border-color:var(--line-2);background:var(--surface-2)}
.habit .row{display:flex;align-items:flex-start;gap:14px}
.check{
  width:34px;height:34px;flex:0 0 auto;border-radius:50%;
  border:1.5px solid var(--line-2);background:transparent;
  color:transparent;display:grid;place-items:center;
  transition:.15s;font-size:16px;font-weight:600;
  margin-top:2px;
}
.check:hover{border-color:var(--accent)}
.check.on{background:var(--accent);border-color:var(--accent);color:#1a1408}
.habit .nm{font-family:var(--serif);font-size:15.5px;font-weight:600}
.habit.done .nm{color:var(--text-3);text-decoration:line-through;text-decoration-color:var(--text-3)}
.habit .meta{font-size:12px;color:var(--text-3);margin-top:2px;letter-spacing:.01em}
.habit .meta b{color:var(--text-2);font-weight:500}

.strip{display:flex;gap:4px;margin-top:12px}
.sd{
  width:22px;height:22px;border-radius:6px;font-size:10px;
  display:grid;place-items:center;color:var(--text-3);
  background:var(--surface-3);font-weight:500;
}
.sd.on{background:var(--accent);color:#1a1408;font-weight:700}
.sd.miss{background:var(--danger-soft);color:var(--danger)}
.sd.off{background:transparent;border:1px solid var(--line);color:var(--text-3)}

.quote{
  margin-top:14px;padding-top:14px;border-top:1px solid var(--line);
  font-family:var(--serif);font-style:italic;font-size:13.5px;color:var(--text-2);line-height:1.55;
}

/* ---------- progress ---------- */
.chart{display:flex;align-items:flex-end;gap:8px;height:132px;margin:8px 0 4px}
.bcol{flex:1;display:flex;flex-direction:column;align-items:center;gap:6px;height:100%;justify-content:flex-end}
.bar2{width:100%;border-radius:5px 5px 2px 2px;background:var(--surface-3);min-height:3px;transition:.3s}
.bar2.g{background:var(--accent)}
.bar2.m{background:rgba(201,169,97,.5)}
.bar2.l{background:var(--danger-soft)}
.blab{font-size:10px;color:var(--text-3);letter-spacing:.05em}

.statgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.stat{
  background:var(--bg-2);border:1px solid var(--line);
  border-radius:10px;padding:12px 10px;text-align:center;
}
.stat b{font-family:var(--serif);font-size:22px;font-weight:600;display:block;letter-spacing:-.02em}
.stat span{font-size:10.5px;color:var(--text-3);letter-spacing:.06em;text-transform:uppercase;margin-top:2px;display:block}

.hbar{height:5px;border-radius:3px;background:var(--surface-3);overflow:hidden;margin-top:6px}
.hbar>i{display:block;height:100%;background:var(--accent);border-radius:3px;transition:width .3s}

.daylist{display:flex;flex-direction:column;gap:9px}
.drow{display:flex;align-items:center;gap:12px;font-size:12.5px}
.drow .dn{width:64px;color:var(--text-3);letter-spacing:.02em}
.drow .db{flex:1;height:4px;border-radius:2px;background:var(--surface-3);overflow:hidden}
.drow .db>i{display:block;height:100%;background:var(--accent);border-radius:2px}
.drow .dv{width:52px;text-align:right;color:var(--text-2);font-variant-numeric:tabular-nums}

.badges{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.badge{
  text-align:center;padding:14px 8px;border-radius:12px;
  background:var(--bg-2);border:1px solid var(--line);
  opacity:.45;transition:.2s;
}
.badge.on{opacity:1;border-color:var(--accent-line);background:var(--accent-soft)}
.badge b{font-family:var(--serif);font-size:22px;font-weight:600;display:block}
.badge span{font-size:10.5px;color:var(--text-3);letter-spacing:.05em;text-transform:uppercase}

/* ---------- discover / library ---------- */
.searchwrap{position:relative;margin-bottom:14px}
.searchwrap svg{position:absolute;left:12px;top:50%;transform:translateY(-50%);width:16px;height:16px;color:var(--text-3);pointer-events:none}
.searchwrap .in{padding-left:36px}

.cats{display:flex;gap:6px;overflow-x:auto;padding-bottom:6px;margin-bottom:16px;-ms-overflow-style:none;scrollbar-width:none}
.cats::-webkit-scrollbar{display:none}
.cat{
  flex:0 0 auto;padding:6px 12px;border-radius:20px;
  background:transparent;border:1px solid var(--line);
  color:var(--text-3);font-size:12.5px;transition:.15s;white-space:nowrap;
}
.cat:hover{color:var(--text-2);border-color:var(--line-2)}
.cat.on{background:var(--accent);border-color:var(--accent);color:#1a1408;font-weight:600}

.lib-grid{display:grid;grid-template-columns:1fr;gap:10px}
@media(min-width:560px){ .lib-grid{grid-template-columns:1fr 1fr} }
.lib-card{
  text-align:left;background:var(--surface);border:1px solid var(--line);
  border-radius:var(--r);padding:14px 16px;transition:.15s;color:inherit;
  display:flex;flex-direction:column;gap:6px;
}
.lib-card:hover{border-color:var(--accent-line);background:var(--surface-2)}
.lib-card .cn{font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--text-3)}
.lib-card .nn{font-family:var(--serif);font-size:15.5px;font-weight:600}
.lib-card .qm{font-size:12px;color:var(--text-3);margin-top:2px;overflow:hidden;text-overflow:ellipsis;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}
.lib-card .tag{font-size:11px;color:var(--text-3);letter-spacing:.02em}

/* ---------- detail page ---------- */
.crumb{
  display:inline-flex;align-items:center;gap:6px;
  background:transparent;border:none;color:var(--text-3);
  font-size:12.5px;letter-spacing:.02em;padding:0;margin-bottom:14px;
}
.crumb:hover{color:var(--text-2)}
.crumb svg{width:14px;height:14px}

.title-block h1{margin-bottom:6px}
.title-block .sub{color:var(--text-3);font-size:12.5px;letter-spacing:.02em}

.qbox{
  padding:18px 20px;border-left:2px solid var(--accent);
  background:var(--bg-2);border-radius:0 var(--r-sm) var(--r-sm) 0;
  font-family:var(--serif);font-style:italic;font-size:15px;color:var(--text-2);line-height:1.6;
}

.list{margin:0;padding:0;list-style:none}
.list li{
  padding:9px 0;font-size:13.5px;color:var(--text-2);
  border-bottom:1px solid var(--line);display:flex;gap:10px;align-items:flex-start;
}
.list li:last-child{border-bottom:none}
.list li::before{
  content:"";flex:0 0 auto;width:5px;height:5px;border-radius:50%;
  background:var(--accent);margin-top:9px;
}

.book{padding:14px 0;border-bottom:1px solid var(--line)}
.book:last-child{border-bottom:none;padding-bottom:0}
.book:first-child{padding-top:0}
.book b{display:block;font-family:var(--serif);font-size:14.5px;font-weight:600;letter-spacing:-.005em}
.book .au{font-size:11.5px;color:var(--text-3);letter-spacing:.02em;margin-top:2px;display:block}
.book .sm{font-size:13px;color:var(--text-2);margin-top:6px;line-height:1.55}

/* ---------- timer ---------- */
.ringwrap{display:flex;flex-direction:column;align-items:center;padding:20px 0 8px}
.ring{position:relative;width:236px;height:236px}
.ring svg{transform:rotate(-90deg)}
.ring .inr{position:absolute;inset:0;display:grid;place-items:center;text-align:center}
.ring .inr b{
  font-family:var(--serif);font-size:50px;font-weight:500;letter-spacing:-.03em;
  font-variant-numeric:tabular-nums;line-height:1;
}
.ring .inr span{display:block;font-size:12px;color:var(--text-3);letter-spacing:.08em;text-transform:uppercase;margin-top:6px}

/* ---------- day picker ---------- */
.daypick{display:flex;gap:6px;margin-bottom:14px}
.daypick label{
  flex:1;text-align:center;padding:10px 0;border-radius:9px;
  background:var(--bg-2);border:1px solid var(--line);
  font-size:12px;color:var(--text-3);cursor:pointer;
  letter-spacing:.04em;transition:.15s;
}
.daypick input{display:none}
.daypick label:hover{color:var(--text-2)}
.daypick label:has(input:checked){background:var(--accent);border-color:var(--accent);color:#1a1408;font-weight:600}

/* ---------- misc ---------- */
.pill{
  display:inline-block;padding:3px 9px;border-radius:20px;font-size:11px;
  background:var(--bg-2);border:1px solid var(--line);color:var(--text-3);
  letter-spacing:.02em;margin:0 4px 4px 0;
}
.pill.on{border-color:var(--accent-line);color:var(--accent)}
.empty{
  text-align:center;padding:40px 20px;color:var(--text-3);
  font-size:13.5px;line-height:1.7;
}
.empty .ic{width:44px;height:44px;margin:0 auto 14px;color:var(--text-3);opacity:.6}

.toast{
  position:fixed;left:50%;bottom:100px;transform:translate(-50%,20px);
  z-index:100;pointer-events:none;opacity:0;transition:.25s;
  max-width:calc(100vw - 32px);
}
@media(min-width:721px){ .toast{bottom:32px} }
.toast.show{opacity:1;transform:translate(-50%,0)}
.toast .tt{
  background:#1a1f25;border:1px solid var(--line-2);
  border-radius:10px;padding:11px 16px;font-size:13px;
  box-shadow:0 10px 32px rgba(0,0,0,.5);color:var(--text);
}

/* focus visibility */
:focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:6px}
</style>
</head>
<body>
<div id="app"></div>
<div id="toast" class="toast"></div>

<script>
"use strict";
/* ============================================================
   Discipline Tracker
   ============================================================ */

/* ---------------- utilities ---------------- */
const pad=n=>String(n).padStart(2,"0");
const dk=d=>`${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}`;
const pk=k=>{const[a,b,c]=k.split("-").map(Number);return new Date(a,b-1,c)};
const mid=d=>{const x=new Date(d);x.setHours(0,0,0,0);return x};
const today=()=>mid(new Date());
const addD=(d,n)=>{const x=new Date(d);x.setDate(x.getDate()+n);x.setHours(0,0,0,0);return x};
const uid=()=>Math.random().toString(36).slice(2,10);
const esc=s=>String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const DL={0:"S",1:"M",2:"T",3:"W",4:"T",5:"F",6:"S"};
const DORD=[1,2,3,4,5,6,0];
const DFULL=["Sunday","Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"];
const DSHORT=["Sun","Mon","Tue","Wed","Thu","Fri","Sat"];
const MON=["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
