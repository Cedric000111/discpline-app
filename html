   STATE
   ============================================================ */
const KEY="discipline-tracker-v2";
let state=load();

function seed(){
  const t=today();
  const created=dk(addD(t,-34));
  const habits=[
    {id:uid(),name:"Read a book",time:"21:00",duration:30,days:[0,1,2,3,4,5,6],cat:"Reading",created},
    {id:uid(),name:"Morning run",time:"06:30",duration:25,days:[1,3,5],cat:"Exercise",created},
    {id:uid(),name:"Meditation",time:"07:30",duration:10,days:[0,1,2,3,4,5,6],cat:"Meditation",created}
  ];
  const log={};
  for(let i=34;i>=0;i--){
    const d=addD(t,-i),k=dk(d);
    const p=i<4?.92:.74;
    habits.forEach(h=>{
      if(h.days.includes(d.getDay())&&Math.random()<p){
        log[k]=log[k]||{}; log[k][h.id]=true;
      }
    });
  }
  return {habits,log,reflections:{},settings:{notifications:false,ai:"deepseek"},reminded:{},timer:null};
}
function load(){
  try{
    const raw=localStorage.getItem(KEY);
    if(raw){
      const s=JSON.parse(raw);
      s.habits=s.habits||[];
      s.log=s.log||{};
      s.reflections=s.reflections||{};
      s.settings=Object.assign({notifications:false,ai:"deepseek"},s.settings||{});
      s.reminded=s.reminded||{};
      s.timer=s.timer||null;
      return s;
    }
  }catch(e){console.warn(e)}
  const s=seed();
  try{localStorage.setItem(KEY,JSON.stringify(s))}catch(e){}
  return s;
}
function save(){ try{localStorage.setItem(KEY,JSON.stringify(state))}catch(e){} }

/* ============================================================
   LOGIC
   ============================================================ */
const schedOn=(h,d)=>h.days.includes(d.getDay())&&dk(d)>=h.created;
const isDone=(id,k)=>!!(state.log[k]&&state.log[k][id]);

function mark(id,k,val=true){
  state.log[k]=state.log[k]||{};
  if(val)state.log[k][id]=true; else delete state.log[k][id];
  if(!Object.keys(state.log[k]).length)delete state.log[k];
  save();
}
function habitsOn(k){
  const d=pk(k);
  return state.habits.filter(h=>schedOn(h,d)).sort((a,b)=>a.time.localeCompare(b.time));
}
function dayStats(k){
  const hs=habitsOn(k);
  const done=hs.filter(h=>isDone(h.id,k)).length;
  return {total:hs.length,done,pct:hs.length?Math.round(done/hs.length*100):0};
}
function curStreak(h){
  const t=today(); let c=0,d=new Date(t),g=0;
  while(g++<4000){
    if(dk(d)<h.created)break;
    if(schedOn(h,d)){
      if(isDone(h.id,dk(d)))c++;
      else if(dk(d)!==dk(t))break;
    }
    d=addD(d,-1);
  }
  return c;
}
function bestStreak(h){
  let best=0,cur=0,d=pk(h.created),t=today(),g=0;
  while(d<=t&&g++<4000){
    if(schedOn(h,d)){
      if(isDone(h.id,dk(d))){cur++;if(cur>best)best=cur}
      else if(dk(d)!==dk(t))cur=0;
    }
    d=addD(d,1);
  }
  return best;
}
function rate(h,days){
  const t=today(); let s=0,d=0;
  for(let i=0;i<days;i++){
    const x=addD(t,-i);
    if(schedOn(h,x)){s++;if(isDone(h.id,dk(x)))d++}
  }
  return {sched:s,done:d,pct:s?Math.round(d/s*100):0};
}
function xpTotal(){
  let n=0; for(const k in state.log) for(const id in state.log[k]) if(state.log[k][id])n++;
  return n;
}
const lvl=()=>{const x=xpTotal();return{xp:x,level:Math.floor(x/100)+1,into:x%100}};

/* pick a quote for a habit on a given day */
function quoteFor(h,k){
  // user habits derived from library: use library quote
  const lib=LIB.find(x=>x.n.toLowerCase()===h.name.toLowerCase());
  if(lib) return lib.q;
  const arr=[
    "We are what we repeatedly do. Excellence, then, is not an act, but a habit. — Will Durant",
    "Discipline equals freedom. — Jocko Willink",
    "You do not rise to the level of your goals. You fall to the level of your systems. — James Clear",
    "The secret of getting ahead is getting started. — Mark Twain",
    "A year from now you may wish you had started today. — Karen Lamb",
    "Success is the sum of small efforts repeated day in and day out. — Robert Collier",
    "Well begun is half done. — Aristotle",
    "It is not that we have a short time to live, but that we waste much of it. — Seneca"
  ];
  return arr[hash(k+h.id)%arr.length];
}

